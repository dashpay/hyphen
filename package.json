{
  "name": "hyphen",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "supportedArchitectures": {
      "os": ["linux", "darwin"],
      "cpu": ["x64", "arm64"],
      "libc": ["glibc"]
    }
  },
  "scripts": {
    "dev:webui": "pnpm --filter @repo/hyphen-webui dev",
    "dev:views": "pnpm --filter @repo/hyphen-views dev",
    "build": "pnpm build:eslint && pnpm build:i18n && pnpm build:api && pnpm build:views && pnpm build:webui",
    "build:api": "pnpm --filter @repo/hyphen-api build",
    "build:eslint": "pnpm --filter @repo/eslint-rules build",
    "build:i18n": "pnpm --filter @repo/hyphen-i18n build",
    "build:webui": "pnpm --filter @repo/hyphen-webui build",
    "build:views": "pnpm --filter @repo/hyphen-views build",
    "bench:api": "pnpm --filter @repo/hyphen-api bench",
    "preview:webui": "pnpm --filter @repo/hyphen-webui preview",
    "preview:views": "pnpm --filter @repo/hyphen-views preview",
    "play:webui": "pnpm --filter @repo/hyphen-webui play",
    "test:webui:unit": "pnpm --filter @repo/hyphen-webui test:unit",
    "i18n:check": "pnpm --filter @repo/hyphen-i18n run:check",
    "i18n:format": "pnpm --filter @repo/hyphen-i18n run:format",
    "i18n:gen": "pnpm --filter @repo/hyphen-i18n run:gen",
    "format": "pnpm format:eslint && pnpm format:i18n && pnpm format:api && pnpm format:views && pnpm format:webui",
    "format:api": "pnpm --filter @repo/hyphen-api format",
    "format:eslint": "pnpm --filter @repo/eslint-rules format",
    "format:i18n": "pnpm --filter @repo/hyphen-i18n format",
    "format:webui": "pnpm --filter @repo/hyphen-webui format",
    "format:views": "pnpm --filter @repo/hyphen-views format",
    "format:check": "pnpm format:check:eslint && pnpm format:check:i18n && pnpm format:check:api && pnpm format:check:views && pnpm format:check:webui",
    "format:check:api": "pnpm --filter @repo/hyphen-api format:check",
    "format:check:eslint": "pnpm --filter @repo/eslint-rules format:check",
    "format:check:i18n": "pnpm --filter @repo/hyphen-i18n format:check",
    "format:check:webui": "pnpm --filter @repo/hyphen-webui format:check",
    "format:check:views": "pnpm --filter @repo/hyphen-views format:check",
    "lint": "pnpm lint:eslint && pnpm lint:i18n && pnpm lint:api && pnpm lint:views && pnpm lint:webui",
    "lint:api": "pnpm --filter @repo/hyphen-api lint",
    "lint:eslint": "pnpm --filter @repo/eslint-rules lint",
    "lint:i18n": "pnpm --filter @repo/hyphen-i18n lint",
    "lint:webui": "pnpm --filter @repo/hyphen-webui lint",
    "lint:views": "pnpm --filter @repo/hyphen-views lint",
    "lint:fix": "pnpm lint:fix:eslint && pnpm lint:fix:i18n && pnpm lint:fix:api && pnpm lint:fix:views && pnpm lint:fix:webui",
    "lint:fix:api": "pnpm --filter @repo/hyphen-api lint:fix",
    "lint:fix:eslint": "pnpm --filter @repo/eslint-rules lint:fix",
    "lint:fix:i18n": "pnpm --filter @repo/hyphen-i18n lint:fix",
    "lint:fix:webui": "pnpm --filter @repo/hyphen-webui lint:fix",
    "lint:fix:views": "pnpm --filter @repo/hyphen-views lint:fix",
    "check": "pnpm check:eslint && pnpm check:i18n && pnpm check:api && pnpm check:views && pnpm check:webui",
    "check:api": "pnpm --filter @repo/hyphen-api check",
    "check:eslint": "pnpm --filter @repo/eslint-rules check",
    "check:i18n": "pnpm --filter @repo/hyphen-i18n check",
    "check:webui": "pnpm --filter @repo/hyphen-webui check",
    "check:views": "pnpm --filter @repo/hyphen-views check",
    "test:api": "pnpm --filter @repo/hyphen-api test"
  }
}

# syntax=docker/dockerfile:1

FROM rust:1.93.1-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev cmake g++ pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY pkgs/ pkgs/

RUN cargo build --release -p hyphend

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system hyphen && useradd --system --gid hyphen --create-home hyphen

COPY --from=builder /src/target/release/hyphend /usr/local/bin/hyphend

RUN mkdir -p /data && chown hyphen:hyphen /data

USER hyphen
VOLUME /data
EXPOSE 3080

ENTRYPOINT ["hyphend"]
CMD ["--datadir", "/data"]

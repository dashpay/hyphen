{
  "db_name": "PostgreSQL",
  "query": "SELECT address, balance, total_received,\n                  (total_received - balance)::bigint AS \"total_sent!\", tx_count\n             FROM address_stats\n            WHERE balance > 0\n              AND (balance < $1 OR (balance = $1 AND address > $2))\n            ORDER BY balance DESC, address ASC LIMIT $3",

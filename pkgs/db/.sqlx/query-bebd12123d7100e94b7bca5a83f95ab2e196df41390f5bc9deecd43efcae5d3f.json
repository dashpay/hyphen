  "db_name": "PostgreSQL",
  "query": "SELECT height, tx_count, utxos_spendable, utxos_unspendable, blockchain_size,\n                credit_pool_balance, circulating_supply, difficulty\n           FROM block_metrics\n          WHERE height >= $1 AND height <= $2\n            AND ($3 <= 1 OR (height % $3) = 0)\n          ORDER BY height ASC\n          LIMIT $4",

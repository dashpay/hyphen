{
  base: {
    "hy-chart-brush-fill": "color-mix(in srgb, var(--accent-blue) 20%, transparent)",
    "hy-chart-brush-stroke": "color-mix(in srgb, var(--accent-blue) 50%, transparent)",
    "hy-chart-tooltip-shadow": "rgba(0, 0, 0, 0.4)",
    "hy-chart-grid": "color-mix(in srgb, white 12%, transparent)",
    "hy-chart-ticks": "color-mix(in srgb, white 62%, transparent)",
    "hy-chart-tooltip-bg": "color-mix(in srgb, #112033 92%, white)",
    "hy-chart-close-bg": "color-mix(in srgb, white 8%, transparent)",
    "hy-chart-close-hover": "color-mix(in srgb, white 14%, transparent)",
    "hy-chart-pill-bg": "color-mix(in srgb, white 6%, transparent)",
    "hy-chart-pill-hover": "color-mix(in srgb, var(--accent-blue) 18%, transparent)",
    "hy-chart-pill-padding": "6px 12px",
    "hy-chart-close-size": "36px",
    "hy-chart-tooltip-padding": "8px 12px",
    "hy-chart-panel-header-padding": "20px 24px",
    "hy-chart-panel-body-padding": "16px 24px 20px",
    "hy-chart-overlay-width": "min(1120px, calc(100vw - 64px))",
    "hy-chart-overlay-height": "min(760px, calc(100dvh - 64px))",
    "hy-chart-overlay-radius": "var(--radius-card)",
    "hy-chart-overlay-viewport-gap": "32px",
    "hy-chart-overlay-viewport-gap-phone": "24px",
    "hy-chart-overlay-width-phone": "calc(100vw - var(--hy-chart-overlay-viewport-gap-phone))",
    "hy-chart-overlay-height-phone": "calc(100dvh - var(--hy-chart-overlay-viewport-gap-phone))",
  },
  light: {
    "hy-chart-tooltip-shadow": "rgba(12, 28, 51, 0.16)",
    "hy-chart-grid": "color-mix(in srgb, #0c1c33 12%, transparent)",
    "hy-chart-ticks": "color-mix(in srgb, #0c1c33 58%, white)",
    "hy-chart-tooltip-bg": "var(--surface-base)",
    "hy-chart-close-bg": "color-mix(in srgb, #0c1c33 6%, white)",
    "hy-chart-close-hover": "color-mix(in srgb, #0c1c33 12%, white)",
    "hy-chart-pill-bg": "color-mix(in srgb, #0c1c33 5%, white)",
    "hy-chart-pill-hover": "color-mix(in srgb, var(--accent-blue) 10%, white)",
  },
}

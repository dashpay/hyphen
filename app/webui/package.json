{
  "name": "@repo/hyphen-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@repo/hyphen-api": "workspace:*",
    "@repo/hyphen-i18n": "workspace:*",
    "@repo/hyphen-views": "workspace:*",
    "@unovis/svelte": "^1.6.4",
    "@unovis/ts": "^1.6.4",
    "smol-toml": "^1.6.0"
  },
  "scripts": {
    "build": "pnpm gen && svelte-kit sync && vite build",
    "check": "pnpm gen && pnpm verify:tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "tsx ./scripts/dev.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "pnpm --filter @repo/hyphen-views gen && tsx ./src/codegen/run.ts",
    "gen:watch": "tsx ./scripts/gen-watch.ts",
    "lint": "pnpm gen && pnpm verify:tokens && pnpm --filter @repo/eslint-rules build && eslint .",
    "lint:fix": "pnpm gen && pnpm verify:tokens && pnpm --filter @repo/eslint-rules build && eslint . --fix",
    "play": "node --experimental-strip-types ./tests/play.ts",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "pnpm test:unit",
    "test:playwright": "playwright test",
    "test:unit": "node --experimental-strip-types --test ./tests/unit/*.test.ts",
    "verify:tokens": "tsx ./src/codegen/verify.ts"
  },
  "devDependencies": {
    "@repo/eslint-rules": "workspace:*",
    "@eslint/js": "^9.0.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/roentgen": "^1.2.10",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/tabler": "^1.2.31",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^25.3.3",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-license-header": "^0.6.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-svelte": "^2.0.0",
    "json5": "^2.2.3",
    "playwright": "^1.58.2",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "sass": "^1.94.2",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "svelte-eslint-parser": "^1.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.2.6"
  }
}

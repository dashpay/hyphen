{
  "name": "@repo/hyphen-views",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./theme.css": "./src/lib/theme/theme.css",
    "./breakpoints": {
      "types": "./src/lib/theme/breakpoints.ts",
      "default": "./src/lib/theme/breakpoints.ts"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm gen && svelte-kit sync && vite build",
    "check": "pnpm gen && pnpm verify:tokens && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "pnpm gen && svelte-kit sync && concurrently -k -n gen,vite -c auto \"pnpm gen:watch\" \"vite dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "tsx ./src/codegen/run.ts",
    "gen:watch": "tsx ./src/codegen/run.ts --watch",
    "lint": "pnpm gen && pnpm verify:tokens && pnpm --filter @repo/eslint-rules build && eslint .",
    "lint:fix": "pnpm gen && pnpm verify:tokens && pnpm --filter @repo/eslint-rules build && eslint . --fix",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "verify:tokens": "tsx ./src/codegen/verify.ts"
  },
  "devDependencies": {
    "@repo/eslint-rules": "workspace:*",
    "@repo/hyphen-i18n": "workspace:*",
    "@eslint/js": "^9.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^25.3.3",
    "chokidar": "^4.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-license-header": "^0.6.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-svelte": "^2.0.0",
    "json5": "^2.2.3",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "sass": "^1.94.2",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "svelte-eslint-parser": "^1.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.6"
  }
}

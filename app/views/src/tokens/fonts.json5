{
  families: {
    primary: '"Manrope", system-ui, sans-serif',
    mono: '"JetBrains Mono", ui-monospace, monospace',
    primaryZh: '"Huninn", "Manrope", system-ui, sans-serif',
  },
  textScale: {
    xs: 10,
    sm: 12,
    "sm+": 13,
    base: 14,
    "base+": 15,
    md: 16,
    "md+": 18,
    lg: 20,
    xl: 24,
    "xl+": 28,
    "2xl": 32,
    "2xl+": 36,
    "3xl": 38,
    "3xl+": 40,
    "4xl": 64,
    "5xl": 96,
  },
  fontWeight: {
    light: 300,
    regular: 400,
    medium: 500,
    semibold: 600,
    bold: 700,
    extrabold: 800,
  },
  localeOverrides: [
    {
      selector: 'html[lang="zh-CN"], html[lang^="zh-"]',
      vars: {
        "font-primary": '"Huninn", "Manrope", system-ui, sans-serif',
      },
    },
  ],
}
